# Server variables only. Set real values privately in Railway Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BETTER_AUTH_URL=https://YOUR-BACKEND.up.railway.app
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
APP_ORIGINS=https://leenaaloufi.github.io
NODE_ENV=production
PORT=3000
TRUST_PROXY_HOPS=1
# Railway private network: leave DATABASE_SSL=false. For a provider requiring
# TLS, use true (certificate validation remains enabled), plus its CA if needed.
DATABASE_SSL=false
# Used ONCE to create the first manager. Remove the password after first login.
BOOTSTRAP_ADMIN_EMAIL=your-test-email@example.com
BOOTSTRAP_ADMIN_NAME=Leena Aloufi
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS

